# SQLite local (padrão). Caminhos relativos ao diretório backend.
SQLITE_PATH=data/clube.sqlite
PORT=3001
HOST=127.0.0.1
APP_TIMEZONE=America/Sao_Paulo
# Produção: backend conecta ao PostgreSQL do Supabase, com schema privado clube.
# DATABASE_URL=postgresql://USUARIO:SENHA@HOST:5432/postgres
# Use "Session pooler" (porta 5432) se sua rede local não tiver IPv6.
# Nunca use o "Transaction pooler" (porta 6543) neste projeto.
# PGSSL_CA=C:/caminho/prod-ca-2021.crt
# PG_CONNECT_TIMEOUT_MS=10000
# PG_QUERY_TIMEOUT_MS=30000
# PG_STATEMENT_TIMEOUT_MS=30000
# NODE_ENV=production
# APP_ORIGIN=https://seu-dominio.example
# TRUST_PROXY=true
# HOST=0.0.0.0
