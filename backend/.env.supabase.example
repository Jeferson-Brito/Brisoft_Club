# Copie este arquivo para backend/.env e substitua apenas os valores indicados.
# No Supabase: Connect > Session pooler > URI (porta 5432).
DATABASE_URL=postgresql://postgres.PROJECT_REF:SENHA_CODIFICADA@aws-0-REGIAO.pooler.supabase.com:5432/postgres
PORT=3001
HOST=127.0.0.1
APP_TIMEZONE=America/Sao_Paulo

# Enquanto o site for servido apenas neste computador:
NODE_ENV=development
APP_ORIGIN=http://localhost:3001
TRUST_PROXY=false

# Limites de segurança da conexão PostgreSQL.
PG_CONNECT_TIMEOUT_MS=10000
PG_QUERY_TIMEOUT_MS=30000
PG_STATEMENT_TIMEOUT_MS=30000

# Opcional: caminho absoluto para o certificado CA baixado no painel do Supabase.
# PGSSL_CA=C:/caminho/prod-ca-2021.crt
# Somente para teste local quando o Node não reconhecer a cadeia do pooler:
# PGSSL_VERIFY=false

# Use somente durante a cópia inicial do SQLite e remova depois.
# SQLITE_PATH=data/clube.sqlite
# CONFIRM_MIGRATION=yes
